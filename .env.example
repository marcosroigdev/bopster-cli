# Copy this file to .env and adjust it. .env stays out of git.

# Your wallet. With it set, a key for any other wallet is refused, and `check` and `status` work
# without the key.
BOPSTER_WALLET=

# Where your private key lives (outside the repo, chmod 600). Default: ~/.bopster/private-key
# BOPSTER_KEY_FILE=/Users/you/.bopster/private-key

# base (mainnet, the default) or base-sepolia (against a local MCP and backend)
# BOPSTER_NETWORK=base

# Base RPC for reads and sends. Default: Base's public one (free, rate-limited).
# BOPSTER_RPC_URL=https://mainnet.base.org

# The MCP. Default: the production one.
# BOPSTER_MCP_URL=https://mcp.bopster.fun/mcp

# Caps: the CLI won't go past these, whatever a plan says.
BOPSTER_MAX_STAKE_PER_SIDE=50
BOPSTER_MAX_STAKE_PER_MARKET=100

# Minimum ETH for gas before starting. A market with two positions uses about 2M gas: roughly
# 0.00002-0.0001 ETH on Base.
# BOPSTER_MIN_ETH=0.0003

# If Base gas goes over this, nothing is sent.
# BOPSTER_MAX_FEE_GWEI=1
